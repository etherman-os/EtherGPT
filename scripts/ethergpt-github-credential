#!/usr/bin/env bash
set -euo pipefail

if [[ "${1:-}" != "get" ]]; then
  exit 0
fi

protocol=""
host=""
while IFS='=' read -r key value; do
  case "$key" in
    protocol) protocol="$value" ;;
    host) host="$value" ;;
  esac
done

if [[ "$protocol" != "https" || "$host" != "github.com" ]]; then
  exit 0
fi

token_file="${ETHERGPT_GITHUB_TOKEN_FILE:-${HOME:-/root}/.config/ethergpt/secrets/github.token}"
if [[ ! -s "$token_file" ]]; then
  exit 0
fi

printf '%s\n' 'username=x-access-token'
printf '%s' 'password='
tr -d '\r\n' <"$token_file"
printf '\n'
